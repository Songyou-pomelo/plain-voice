{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Plain Voice: Validate",
      "type": "process",
      "command": "python",
      "args": [
        "scripts/validate.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Plain Voice: Test",
      "type": "process",
      "command": "python",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Plain Voice: Package",
      "type": "process",
      "command": "python",
      "args": [
        "scripts/package.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
